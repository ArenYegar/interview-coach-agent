# 复制为 .env 并填入你自己的 Key（.env 已被 .gitignore 忽略）
# 任选其一即可，优先级见 coach/config.py
COACH_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# OpenAI 兼容端点（阿里百炼/DashScope 示例）
COACH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型与降级链（逗号分隔可自定义）
COACH_MODEL=
COACH_TEMPERATURE=0.3
COACH_MAX_TOKENS=900
COACH_MAX_QUESTIONS=5

# ===== 换供应商：DeepSeek =====
# 只改下面三行（上面 DashScope 那三行注释掉即可）：
# DEEPSEEK_API_KEY=sk-你的key
# COACH_BASE_URL=https://api.deepseek.com
# COACH_MODEL=deepseek-flash,deepseek-chat    # 逗号分隔＝降级链（deepseek-v4-flash 是同一个模型的别名，
#                                            # 本端点上 deepseek-chat 也解析到 deepseek-flash）
# COACH_MAX_TOKENS=2048                       # 推理型模型会额外产生 reasoning token，预算给足
# 不写 COACH_MODEL 时按端点自动选链：DeepSeek → deepseek-flash/deepseek-chat；DashScope → qwen-plus/max/turbo。
# 注意：deepseek-v4-pro 是重推理模型，可能把 token 预算全花在 reasoning 上而返回空内容，故不作默认（要用可 --model 指定）。

# ===== 评测口径：决定「两次运行的分数能不能直接比」=====
# 每题模型采样次数。1=练习够用；评测/回归建议 3 —— 同一题重复打分取中位数，
# 用来把单次采样的抖动压小。实测依据 results/stability_*.json：
# 单次采样平均极差约 6pp / 最大 10pp；取中位数后平均约 2.5pp / 最大 5pp。
COACH_SCORE_REPS=1
# 注入防护档位：0=关闭（仅用于对照实验） 1=提示层定界隔离 2=再叠加输出自洽校验（建议默认）
COACH_GUARD=2
# 采样温度：实测把它设成 0 消不掉抖动（差值本身是采样噪声，不是温度引入的），保持默认即可
COACH_TEMPERATURE=0.3
# 可选随机种子：实测本端点加了它反而更抖，默认不设
# COACH_SEED=42
