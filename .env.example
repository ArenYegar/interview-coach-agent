# 复制为 .env 并填入你自己的 Key（.env 已被 .gitignore 忽略）
# 任选其一即可，优先级见 coach/config.py
COACH_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# OpenAI 兼容端点（阿里百炼/DashScope 示例）
COACH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型与降级链（逗号分隔可自定义）
COACH_MODEL=
COACH_TEMPERATURE=0.3
# 可选随机种子：实测本端点加了它反而更抖，默认不设
# COACH_SEED=42

# 接口门禁（可选）：设了之后 /api/* 与 /report/* 必须带 Authorization: Bearer <TOKEN>
# 注意：这是「门禁」不是多租户 —— 单个共享 token 只回答“谁能访问”，不区分场次归属
# COACH_API_TOKEN=<你的token>

# 打分结果缓存：同一（模型+提示版本+防护档+采样次数+题+答案）不重复花钱；命中记在 ScoreCard.cached。
# 默认 0（关）—— 开了之后“重复跑分数一模一样”，会掩盖模型自身的抖动；评测重跑同一批答案时再开。
# 改了 score_answer 的提示词/防护时，务必同步改 coach/cache.py 里的 PROMPT_VERSION
COACH_CACHE=0

# 独立调用的并发度（示例：同一题的 3 次重复采样会并发发出）。别设太大，下游 API 有限流
COACH_PARALLEL=4
